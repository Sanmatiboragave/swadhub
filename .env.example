# Email Service Configuration
# Copy this file to .env and fill in your actual credentials
# DO NOT commit .env to git!

# SMTP Server Settings (Gmail example)
FLASK_MAIL_SERVER=smtp.gmail.com
FLASK_MAIL_PORT=587
FLASK_MAIL_USERNAME=your-email@gmail.com
FLASK_MAIL_PASSWORD=your-16-char-app-password

# Sender Email
FLASK_MAIL_FROM=noreply@swadhub.com

# EmailJS Configuration (Alternative to backend)
# Uncomment these if using EmailJS instead of Flask backend
# REACT_APP_EMAILJS_SERVICE_ID=service_xxx
# REACT_APP_EMAILJS_TEMPLATE_SIGNUP=template_signup_xxx
# REACT_APP_EMAILJS_TEMPLATE_LOGIN=template_login_xxx
# REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key_xxx

# Frontend API Proxy
# Set to your backend email service URL
VITE_API_URL=http://localhost:5000
